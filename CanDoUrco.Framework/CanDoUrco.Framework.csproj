<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="runtimes\**\*.*">
      <PackagePath>runtimes</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PublishState>Included</PublishState>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CanDoUrco.NativeLibraryLoaderConfigurer/CanDoUrco.NativeLibraryLoaderConfigurer.csproj" />
    <ProjectReference Include="../CanDoUrco.OpenGL.Generator/CanDoUrco.OpenGL.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>

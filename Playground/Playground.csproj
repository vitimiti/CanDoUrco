<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishTrimmed>true</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CanDoUrco.Glfw/CanDoUrco.Glfw.csproj" />
    <ProjectReference Include="../CanDoUrco.IO/CanDoUrco.IO.csproj" />
    <ProjectReference Include="../CanDoUrco.Utilities/CanDoUrco.Utilities.csproj" />
    <ProjectReference
      Include="../CanDoUrco.OpenGL.Generator/CanDoUrco.OpenGL.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Shaders\Core.Vertex.glsl" />
    <EmbeddedResource Include="Resources\Shaders\Core.Fragment.glsl" />
    <EmbeddedResource Include="Resources\Textures\Wall.jpg" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Sdl3RuntimesDirectory>$(MSBuildThisFileDirectory)..\runtimes\</Sdl3RuntimesDirectory>
  </PropertyGroup>

  <!-- No RID (portable build): copy the whole runtimes tree so the DllImport
       resolver can pick the right library at load time. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
    <None
      Include="$(Sdl3RuntimesDirectory)**\native\*SDL3*"
      Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      Visible="false" />
  </ItemGroup>

  <!-- RID-specific build: copy only the matching library next to the assembly. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <None
      Include="$(Sdl3RuntimesDirectory)$(RuntimeIdentifier)\native\*SDL3*"
      Link="%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      Visible="false" />
  </ItemGroup>

  <Target
    Name="ValidateSdl3RuntimeIdentifier"
    BeforeTargets="PrepareForBuild;CollectPackageReferences"
    Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_Sdl3SupportedRid Include="$([System.IO.Directory]::GetDirectories('$(Sdl3RuntimesDirectory)'))" />
    </ItemGroup>
    <Error
      Condition="!Exists('$(Sdl3RuntimesDirectory)$(RuntimeIdentifier)\native')"
      Text="The RuntimeIdentifier '$(RuntimeIdentifier)' is not supported by CanDoUrco.Native.Sdl3. Supported RIDs: @(_Sdl3SupportedRid->'%(Filename)', ', ')." />
  </Target>
</Project>
